<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 现代化夜间模式配色方案 -->
    
    <!-- 主色调 - 深色模式下的蓝色系 -->
    <color name="modern_primary">#7986CB</color>
    <color name="modern_primary_light">#AAB6FE</color>
    <color name="modern_primary_dark">#49599A</color>
    
    <!-- 次要色调 - 深色模式下的紫色系 -->
    <color name="modern_secondary">#BA68C8</color>
    <color name="modern_secondary_light">#EE98FB</color>
    <color name="modern_secondary_dark">#883997</color>
    
    <!-- 强调色 - 深色模式下的蓝色 -->
    <color name="modern_accent">#448AFF</color>
    <color name="modern_accent_light">#83B9FF</color>
    <color name="modern_accent_dark">#005ECB</color>
    
    <!-- 中性色系 - 深色背景 -->
    <color name="modern_surface">#1E1E1E</color>
    <color name="modern_surface_variant">#2D2D2D</color>
    <color name="modern_background">#121212</color>
    
    <!-- 文本颜色 - 深色模式下的高对比度 -->
    <color name="modern_on_primary">#000000</color>
    <color name="modern_on_secondary">#000000</color>
    <color name="modern_on_surface">#FFFFFF</color>
    <color name="modern_on_surface_variant">#B3B3B3</color>
    
    <!-- 状态颜色 -->
    <color name="modern_success">#81C784</color>
    <color name="modern_warning">#FFB74D</color>
    <color name="modern_error">#E57373</color>
    <color name="modern_info">#64B5F6</color>
    
    <!-- 图标和按钮颜色 -->
    <color name="modern_icon_active">@color/modern_accent</color>
    <color name="modern_icon_inactive">#8A8A8A</color>
    
    <!-- 阴影和边框颜色 -->
    <color name="modern_shadow">#1AFFFFFF</color>
    <color name="modern_border">#404040</color>
    
    <!-- 底部导航栏颜色 -->
    <color name="modern_bottom_nav_tint">@color/modern_icon_active</color>
</resources>